/* 首页 */
.page {
  padding: 0 28rpx 40rpx;
}

.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 8rpx 24rpx;
}
.nav .title {
  font-size: 34rpx;
  font-weight: 600;
}
.chip {
  border-radius: 16rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  border: 1px solid var(--border2);
  color: var(--sub);
  background: #fff;
}

/* 主 CTA */
.cta {
  background: var(--purple);
  border-radius: 32rpx;
  padding: 32rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.cta.dim {
  opacity: 0.55;
}
.cta-title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}
.cta-sub {
  font-size: 22rpx;
  color: var(--purple-pale);
  margin-top: 6rpx;
  display: block;
}
.cta-btn {
  background: var(--purple-light);
  color: var(--purple);
  border-radius: 18rpx;
  padding: 16rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.cta:active {
  opacity: 0.9;
}

.label {
  font-size: 22rpx;
  color: var(--faint);
  display: block;
  margin: 0 0 12rpx 4rpx;
}

/* 三科卡 */
.subjects {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.subj {
  flex: 1;
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}
.subj.off {
  border-style: dashed;
  opacity: 0.65;
}
.subj-ico {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 22rpx;
  margin: 0 auto 12rpx;
}
.subj-ico.zh {
  background: var(--zh-bg);
  color: var(--zh);
}
.subj-ico.math {
  background: var(--math-bg);
  color: var(--math);
}
.subj-ico.en {
  background: var(--en-bg);
  color: var(--en);
}
.subj-name {
  font-size: 24rpx;
  font-weight: 600;
  display: block;
}
.subj-sub {
  font-size: 20rpx;
  color: var(--faint);
  margin-top: 4rpx;
  display: block;
}

/* 周报摘要 */
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
}
.week-text {
  font-size: 22rpx;
  color: var(--sub);
}

/* 年级弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  width: 100%;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  text-align: center;
  margin-bottom: 28rpx;
}
.grade-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.grade-item {
  background: var(--bg);
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
}
.grade-item.on {
  background: var(--purple-light);
  color: var(--purple);
  border: 3rpx solid var(--purple);
  font-weight: 600;
}
.grade-item.lock {
  opacity: 0.6;
}
.grade-lock {
  display: block;
  font-size: 18rpx;
  color: var(--faint);
  font-weight: 400;
  margin-top: 4rpx;
}
.sheet-note {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: var(--faint);
  margin-top: 24rpx;
}
