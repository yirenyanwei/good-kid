.page {
  padding: 24rpx 28rpx 40rpx;
}

.filters {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}
.f-tab {
  border-radius: 16rpx;
  padding: 8rpx 22rpx;
  font-size: 20rpx;
  background: #fff;
  border: 2rpx solid var(--border2);
  color: var(--sub);
  font-weight: 600;
}
.f-tab.on {
  background: var(--purple);
  color: #fff;
  border-color: var(--purple);
}

.progress-card {
  background: var(--purple-light);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.progress-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.progress-label {
  font-size: 24rpx;
  color: var(--sub);
}
.progress-num {
  font-size: 24rpx;
  color: var(--purple);
  font-weight: 600;
}
.bar {
  height: 14rpx;
  border-radius: 7rpx;
  background: #fff;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: var(--purple);
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}
.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 22rpx;
  color: var(--faint);
}

.item-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.item-content {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}
.item-detail {
  font-size: 22rpx;
  color: var(--faint);
  display: block;
  margin-top: 4rpx;
}
.item-badge {
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
  font-size: 18rpx;
  background: var(--purple-light);
  color: var(--purple);
  font-weight: 600;
}
.item-badge.near {
  background: var(--ok-bg);
  color: var(--ok);
}
