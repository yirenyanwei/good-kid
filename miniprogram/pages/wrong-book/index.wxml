<view class="page">
  <view class="filters">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="f-tab {{filter === item.key ? 'on' : ''}}"
      bindtap="pickFilter"
      data-k="{{item.key}}"
    >{{item.name}}</view>
  </view>

  <view class="progress-card">
    <view class="progress-row">
      <text class="progress-label">清零进度 · 累计</text>
      <text class="progress-num">{{total}} → {{active}}</text>
    </view>
    <view class="bar">
      <view class="bar-fill" style="width: {{total > 0 ? (total - active) / total * 100 : 0}}%"></view>
    </view>
  </view>

  <view wx:if="{{items.length === 0}}" class="empty">
    <text class="empty-title">没有待消灭的错题</text>
    <text class="empty-sub">练习中答错的字词会自动出现在这里</text>
  </view>

  <view
    wx:for="{{items}}"
    wx:key="itemRef"
    class="item-card"
    bindtap="onItem"
    data-i="{{index}}"
  >
    <view class="item-left">
      <text class="item-content">{{item.content}}</text>
      <text class="item-detail">{{item.detail}} · 错 {{item.wrongCount}} 次</text>
    </view>
    <view class="item-badge {{item.wrongCount >= 3 ? 'near' : ''}}">
      {{item.wrongCount >= 3 ? '连对 ' + item.streakRight + '/2 毕业' : '加权重现'}}
    </view>
  </view>
</view>
