.page {
  padding: 0 28rpx 40rpx;
}

.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 8rpx 24rpx;
}
.back {
  font-size: 44rpx;
  color: var(--sub);
  width: 60rpx;
}
.nav-center {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.subj-ico {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--zh-bg);
  color: var(--zh);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
}
.chip {
  border-radius: 16rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  border: 1px solid var(--border2);
  color: var(--sub);
  background: #fff;
}

/* 教材行 */
.tb-row {
  background: rgba(0, 0, 0, 0.03);
  border-radius: 24rpx;
  padding: 16rpx 28rpx;
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.tb-label,
.tb-value {
  font-size: 22rpx;
  color: var(--sub);
}

.label {
  font-size: 22rpx;
  color: var(--faint);
  display: block;
  margin: 0 0 12rpx 4rpx;
}

/* 样式卡 */
.style-card {
  background: #fff;
  border: 2rpx solid var(--border2);
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.style-card.hero {
  border: 3rpx solid var(--purple-light);
}
.style-name {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
}
.new-tag {
  font-size: 18rpx;
  color: var(--purple);
  background: var(--purple-light);
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
  font-weight: 400;
}
.style-desc {
  font-size: 22rpx;
  color: var(--faint);
  margin-top: 4rpx;
  display: block;
}
.style-btn {
  border: 2rpx solid var(--border2);
  color: var(--sub);
  border-radius: 14rpx;
  padding: 10rpx 28rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.style-btn.primary {
  background: var(--purple);
  color: #fff;
  border-color: var(--purple);
}
.style-card:active {
  opacity: 0.85;
}

/* 出题范围 */
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.range-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.range-label {
  font-size: 24rpx;
  color: var(--sub);
}
.range-value {
  font-size: 22rpx;
  color: var(--purple);
  font-weight: 600;
}
.unit-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.u-chip {
  border-radius: 16rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  border: 2rpx solid var(--border2);
  color: var(--sub);
  background: #fff;
}
.u-chip.on {
  background: var(--purple);
  color: #fff;
  border-color: var(--purple);
  font-weight: 600;
}

/* 错题卡 */
.wrong-card {
  background: var(--purple-light);
}
.wrong-title {
  font-size: 22rpx;
  color: var(--sub);
  display: block;
  margin-bottom: 12rpx;
}
.wrong-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.bar {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: #fff;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: var(--purple);
}
.wrong-total {
  font-size: 22rpx;
  color: var(--sub);
}
