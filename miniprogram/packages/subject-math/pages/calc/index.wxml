<view class="page">
  <view class="nav">
    <text class="exit" bindtap="onExit">‹ 退出</text>
    <text class="progress">{{index + 1}} / {{total}}</text>
    <text class="streak" wx:if="{{streak >= 2}}">★ {{streak}} 连对</text>
    <text class="nav-ghost" wx:else> </text>
  </view>
  <view class="pbar">
    <view class="pbar-fill" style="width: {{(index + 1) / total * 100}}%"></view>
  </view>

  <view class="body">
    <view class="expr-box">
      <text class="expr">{{expression}}</text>
      <text class="eq">=</text>
      <view class="answer-box {{phase === 'feedback' ? (lastCorrect ? 'ok' : 'bad') : ''}}">
        <text class="answer-num {{input === '' ? 'empty' : ''}}">{{input === '' ? '？' : input}}</text>
      </view>
    </view>

    <text class="feedback {{lastCorrect ? 'ok' : 'bad'}}" wx:if="{{phase === 'feedback'}}">
      {{lastCorrect ? '算对了！' : '正确答案：' + answer}}
    </text>
  </view>

  <view class="keypad">
    <view
      wx:for="{{keys}}"
      wx:key="*this"
      class="key {{item === '清' ? 'k-fn' : ''}} {{item === '⌫' ? 'k-fn' : ''}}"
      bindtap="onKey"
      data-k="{{item}}"
    >{{item}}</view>
    <view class="key k-ok" bindtap="submit">确定</view>
  </view>
</view>
